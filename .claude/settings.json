{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(npx tsc --noEmit)",
      "Bash(npm test)",
      "Bash(npm run test:quiet)",
      "Bash(npx vitest run *)",
      "Bash(npm run lint)",
      "Bash(npm run lint:obsidian)",
      "Bash(npm run lint:obsidian -- --quiet)",
      "Bash(npm run check-quality)",
      "Bash(npm run scan-ert)",
      "Bash(node scripts/css-drift-check.mjs)",
      "Bash(node scripts/check-api-features.mjs *)",
      "Bash(node scripts/lint-obsidian-report.mjs)",
      "mcp__github__pull_request_read",
      "mcp__Claude_Code_Remote__read_documentation",
      "mcp__Claude_Code_Remote__get_session",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:ai.google.dev)",
      "WebFetch(domain:developers.google.com)",
      "WebFetch(domain:docs.cloud.google.com)",
      "WebFetch(domain:generativelanguage.googleapis.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push -u origin claude/*)",
      "Bash(npm run build)",
      "Bash(npm run build-only)",
      "Bash(npm run verify)",
      "Bash(npm run gates)",
      "Bash(npm run css-drift -- --maintenance)",
      "Bash(npm run auditDaily)",
      "Bash(npm run auditFriday)",
      "Bash(npm run auditDeep)",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__send_later",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__create_trigger",
      "mcp__bf7c680d-5fdc-5ef4-b4a0-abadb619bf0a__delete_trigger",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "if ! command -v npm >/dev/null 2>&1; then echo \"gates skipped: npm not on PATH\"; exit 0; fi; output=$(npm run gates 2>&1); exit_code=$?; if [ $exit_code -ne 0 ]; then echo \"GATES FAILED (exit $exit_code) — fix before declaring work complete:\"; echo \"$output\" | tail -50; exit 2; fi; exit 0",
            "timeout": 180,
            "asyncRewake": true,
            "rewakeMessage": "npm run gates failed in the background. Address the violations below before continuing or asking for backup:",
            "rewakeSummary": "Gates failed — fixes required",
            "statusMessage": "Running gates in background…"
          }
        ]
      }
    ]
  }
}
