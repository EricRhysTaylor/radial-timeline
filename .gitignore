# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js
styles.css

# Generated by scripts/embed-plugin-assets.mjs from the binaries under src/.
# Same contract as styles.css: derived artifact, regenerated on every build.
src/generated/

# Build directory should not be committed
build/

# Exclude sourcemaps
*.map

# obsidian
data.json

# Private patent documents - DO NOT COMMIT
private-patent-docs/

# Exclude macOS Finder (System Explorer) View States
.DS_Store
**/.DS_Store

# Backup files
*.bak*
main.keysave*.ts
main.lostacts.ts

# Large package installers
*.pkg
# Do not commit build artifacts for Obsidian plugin
release/

# Generated audit reports (regenerated every build)
scripts/models/feature-audit.json
release-ts/

# Local gate-runner logs
.gate-logs/

# Publishing PDF QA artifact directory — regenerated on every smoke run.
tmp/publishing-pdf-qa/

# Claude Code agent worktrees — created/destroyed by the chip system, never committed.
.claude/worktrees/

# Local verification hold marker — presence makes backup.mjs a no-op. Never committed.
.rt-verification-hold

# Local reference copies — not part of the plugin; Obsidian scorecard scans repo CSS
app.css
vault-restore-point/

# Generated nightly by the Model & Pricing Watch workflow
scripts/models/pricing-watch-report.md

# Deploy watcher runtime logs (Mac Studio local)
.deploy-watch.log
.deploy-watch.err
