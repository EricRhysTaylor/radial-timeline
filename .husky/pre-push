# Run the gates BEFORE the push, not after.
#
# The Stop hook in .claude/settings.json only nags once the commits are already
# on origin/main, and it leaves no trace at all when a session ends abnormally.
# That is how CSS-drift and compliance debt landed on 2026-08-07 and did not
# surface until an unrelated session three days later.
#
# `npm run backup` runs the gates itself before pushing, so it sets the skip
# below rather than paying for them twice. To override deliberately (an
# emergency push, or debt you have decided to accept), use `git push --no-verify`.
#
# This supersedes the previous `npm run lint:obsidian` here — the gates run it
# as step 9.
# Never push a HEAD whose tree is much smaller than the remote's: that is the
# signature of a commit made from an evicted .git/index (2026-09-04).
head_count=$(git ls-tree -r --name-only HEAD | wc -l | tr -d ' ')
remote_count=$(git ls-tree -r --name-only origin/main 2>/dev/null | wc -l | tr -d ' ')
if [ "${remote_count:-0}" -gt 100 ] && [ "$head_count" -lt $((remote_count * 8 / 10)) ]; then
  echo "pre-push: HEAD has $head_count files, origin/main has $remote_count. Refusing to push a shrunken tree." >&2
  echo "Rebuild the index from the last complete commit (git read-tree <commit> && git add -u), recommit, then push." >&2
  [ "$RT_ALLOW_TREE_SHRINK" = "1" ] || exit 1
fi

if [ "$RT_SKIP_PREPUSH_GATES" = "1" ]; then
  echo "pre-push: gates already ran for this command; skipping."
  exit 0
fi

npm run gates
